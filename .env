# Spring profiles
SPRING_PROFILES_ACTIVE=local

# --- Local profile (Ollama) default ---
# Set OLLAMA_BASE_URL=auto (or discover) to find an Ollama server on the LAN at boot.
# Explicit URLs are used as-is; discovered hosts are cached in data/discovery/cache.json.
OLLAMA_BASE_URL=http://192.168.1.211:11434
OLLAMA_EMBEDDING_MODEL=nomic-embed-text
OLLAMA_CHAT_MODEL=phi4

# Optional LAN discovery tuning (only used when OLLAMA_BASE_URL=auto|discover)
# OLLAMA_DISCOVERY_ENABLED=true
# OLLAMA_DISCOVERY_PORT=11434
# OLLAMA_DISCOVERY_SUBNETS=192.168.1.0/24,10.0.0.0/24
# OLLAMA_DISCOVERY_MAX_HOSTS=1024

# Optional: GPU-friendly chat model
# OLLAMA_CHAT_MODEL=qwen3:8b

# --- Cloud profile (OpenAI) ---
# SPRING_PROFILES_ACTIVE=cloud
# OPENAI_API_KEY is a secret: set it in scripts/.env.secrets.example -> .env.secrets
OPENAI_CHAT_MODEL=gpt-4o
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# --- Vector store ---
VECTOR_STORE_TYPE=pgvector
PGVECTOR_HOST=localhost
PGVECTOR_PORT=5432
PGVECTOR_DB=rag
PGVECTOR_USER=rag
# PGVECTOR_PASSWORD is a secret: set it in scripts/.env.secrets.example -> .env.secrets
# Per-module PostgreSQL schema (keeps each rag-* approach's data isolated)
PGVECTOR_BASIC_SCHEMA=rag_basic
PGVECTOR_ADVANCED_SCHEMA=rag_advanced
PGVECTOR_AGENTIC_SCHEMA=rag_agentic

# --- Module registry (base URLs used by the TUI control plane) ---
RAG_BASIC_URL=http://localhost:8081
RAG_ADVANCED_URL=http://localhost:8082
RAG_AGENTIC_URL=http://localhost:8083
RAG_MEMORY_URL=http://localhost:8084
RAG_WEBCRAWLER_URL=http://localhost:8085
RAG_TUI_URL=http://localhost:8086

# --- Per-module HTTP ports (injected by each module's application.yml via server.port) ---
# Keep each RAG_*_PORT in sync with the port in the matching RAG_*_URL above.
RAG_BASIC_PORT=8081
RAG_ADVANCED_PORT=8082
RAG_AGENTIC_PORT=8083
RAG_MEMORY_PORT=8084
RAG_WEBCRAWLER_PORT=8085
RAG_PROVIDER_PORT=8086

# --- Chunking defaults ---
CHUNK_SIZE=512
CHUNK_OVERLAP=128

# --- Docker infrastructure ---
# INFRA_MODE: auto (default) — reuses an external Ollama when OLLAMA_BASE_URL is already reachable
#             local          — always starts rag-ollama regardless
INFRA_MODE=auto
# Prometheus/Grafana host ports; when already taken the script auto-rotates to the next free port
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
OLLAMA_PORT=11434
