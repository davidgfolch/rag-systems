# Secrets (copied to .env.secrets at repo root, which is gitignored)
# A random password is auto-generated on first copy by scripts/bootstrap-env.{bat,sh}
# if this is left blank.

# PostgreSQL/pgvector password
PGVECTOR_PASSWORD=

# OpenAI API key (cloud profile)
OPENAI_API_KEY=

# SonarQube bootstrap secrets
# A random password is auto-generated on first copy by scripts/bootstrap-env.{bat,sh}
# if this is left blank.
SONAR_ADMIN_PASSWORD=
# SONAR_TOKEN is auto-generated by scripts/sonar-pw.{bat,sh} on first boot.
# SONAR_TOKEN=
